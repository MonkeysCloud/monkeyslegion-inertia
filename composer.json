{
    "name": "monkeyscloud/monkeyslegion-inertia",
    "description": "Inertia.js server adapter for MonKeysLegion — bridges PHP controllers with React/Vue SPAs.",
    "license": "MIT",
    "type": "library",
    "require": {
        "monkeyscloud/monkeyslegion-core": "^2.1",
        "monkeyscloud/monkeyslegion-http": "^2.1",
        "monkeyscloud/monkeyslegion-router": "^2.2",
        "monkeyscloud/monkeyslegion-session": "^2.0",
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MonkeysLegion\\Inertia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonkeysLegion\\Inertia\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true
}
